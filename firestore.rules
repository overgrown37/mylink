rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─────────────────────────────────────────────────────────────
    // 🛡️ 인증 헬퍼 함수: 로그인 여부 및 본인 UID 일치 확인
    // ─────────────────────────────────────────────────────────────
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // ─────────────────────────────────────────────────────────────
    // 1. users/{userId} (사용자 프로필 문서)
    // ─────────────────────────────────────────────────────────────
    match /users/{userId} {
      // 📖 읽기: 누구나 가능 (방문자 프로필 열람 & 닉네임 검색 지원)
      allow read: if true;

      // ✍️ 쓰기 (생성, 수정, 삭제): 로그인한 본인 UID 일치 시에만 허용
      allow write: if isOwner(userId);

      // ───────────────────────────────────────────────────────────
      // 2. users/{userId}/links/{linkId} (사용자 링크 목록)
      // ───────────────────────────────────────────────────────────
      match /links/{linkId} {
        // 📖 읽기: 누구나 가능 (공개 링크 열람)
        allow read: if true;

        // ✍️ 쓰기: 본인만 생성/수정/삭제 가능
        allow write: if isOwner(userId);
      }

      // ───────────────────────────────────────────────────────────
      // 3. users/{userId}/profile/{docId} (프로필 서브컬렉션 호환)
      // ───────────────────────────────────────────────────────────
      match /profile/{docId} {
        allow read: if true;
        allow write: if isOwner(userId);
      }
    }

    // ─────────────────────────────────────────────────────────────
    // 4. user/{userId}/profile/{docId} (단수형 경로 호환 지원)
    // ─────────────────────────────────────────────────────────────
    match /user/{userId}/profile/{docId} {
      allow read: if true;
      allow write: if isOwner(userId);
    }

    // ─────────────────────────────────────────────────────────────
    // 5. displayNames/{normalizedName} (닉네임 100% 고유성 매핑 컬렉션)
    // ─────────────────────────────────────────────────────────────
    match /displayNames/{normalizedName} {
      // 📖 읽기: 누구나 가능 (중복 체크 및 단일 키 O(1) 조회)
      allow read: if true;

      // ✍️ 생성: 본인 UID + 아직 문서가 존재하지 않을 때만 허용 (!exists로 동시 생성 원천 차단)
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && !exists(/databases/$(database)/documents/displayNames/$(normalizedName));

      // 🔄 수정: 기존 닉네임 소유자 본인만
      allow update: if request.auth != null
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid;

      // 🗑️ 삭제 (닉네임 변경 시 기존 닉네임 해제): 기존 소유자 본인만
      allow delete: if request.auth != null
        && resource.data.uid == request.auth.uid;
    }
  }
}
